<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Spydate.Debugger</RootNamespace>
    <Description>Spydate debugging: launching a binary under a debug loop, breakpoints, registers and memory.</Description>
    <!-- The whole thing is Win32 debugging APIs. Saying so once here beats an attribute per method. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <!--
      CA1416 flags COM interop as Windows-only, which it is, in a project that is Windows-only
      throughout: every type here is a wrapper over a debugging API that exists nowhere else. The
      line above does not reach the analyzer - it is not a property MSBuild knows - and the
      alternative, an assembly-level SupportedOSPlatform, moves the same warnings into the net10.0
      test project, where they would be just as true and just as uninformative.
    -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Iced directly rather than Spydate.Disassembly: stepping over a call needs the length of one
         instruction, not function discovery or listings. -->
    <PackageReference Include="Iced" />
    <!-- Native asset only: dbgshim.dll beside the output, loaded by name at run time. It is native
         code, so it has to match the build: the x86 Spydate loads the x86 one. -->
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.win-x64" GeneratePathProperty="true"
                      Condition="'$(PlatformTarget)' != 'x86'" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.win-x86" GeneratePathProperty="true"
                      Condition="'$(PlatformTarget)' == 'x86'" />
    <!-- ClrMD: the passive managed overlay (ManagedOverlay). -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" />
  </ItemGroup>

  <!--
    The package holds one file, runtimes/win-x64/native/dbgshim.dll, and nothing else - no lib, no
    build targets. A RID-less build does not flow native assets, so without this the reference
    resolves, the build succeeds, and the DLL is simply absent at run time. Copying it by hand beats
    putting a RuntimeIdentifier on a library that has no other reason to want one.
  -->
  <ItemGroup>
    <None Include="$(PkgMicrosoft_Diagnostics_DbgShim_win-x64)\runtimes\win-x64\native\dbgshim.dll"
          Condition="'$(PkgMicrosoft_Diagnostics_DbgShim_win-x64)' != '' And '$(PlatformTarget)' != 'x86'"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="$(PkgMicrosoft_Diagnostics_DbgShim_win-x86)\runtimes\win-x86\native\dbgshim.dll"
          Condition="'$(PkgMicrosoft_Diagnostics_DbgShim_win-x86)' != '' And '$(PlatformTarget)' == 'x86'"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spydate.Core\Spydate.Core.csproj" />
  </ItemGroup>

</Project>
