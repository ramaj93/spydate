<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Spydate dark palette. Dense IDE look (Visual Studio / dnSpy family):
        flat greys, square edges, blue selection. Every control style in
        Themes/Controls.xaml resolves its colours from these keys.
    -->

    <!-- Typography -->
    <FontFamily x:Key="App.FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="Mono.FontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="App.FontSize">12</sys:Double>
    <sys:Double x:Key="Mono.FontSize">12</sys:Double>
    <sys:Double x:Key="Small.FontSize">11</sys:Double>

    <!-- Metrics -->
    <sys:Double x:Key="Row.Height">18</sys:Double>
    <sys:Double x:Key="Header.Height">21</sys:Double>
    <sys:Double x:Key="Tab.Height">22</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

    <!-- Window chrome: title bar, menu, toolbar, status bar -->
    <SolidColorBrush x:Key="Chrome.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="Chrome.Border" Color="#3F3F46" />

    <!-- Tool windows (explorer, output) -->
    <SolidColorBrush x:Key="Panel.Background" Color="#252526" />
    <SolidColorBrush x:Key="Panel.Header.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="Panel.Header.Foreground" Color="#CCCEDB" />

    <!-- Document area -->
    <SolidColorBrush x:Key="Document.Background" Color="#1E1E1E" />
    <SolidColorBrush x:Key="TabStrip.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="Tab.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="Tab.Selected.Background" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Tab.Hover.Background" Color="#3E3E40" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text.Primary" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#A5A5A5" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#7A7A7A" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#656565" />

    <!-- Accents / state -->
    <SolidColorBrush x:Key="Accent" Color="#007ACC" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#1C97EA" />
    <SolidColorBrush x:Key="Selection.Background" Color="#094771" />
    <SolidColorBrush x:Key="Selection.Inactive" Color="#3F3F46" />
    <SolidColorBrush x:Key="Hover.Background" Color="#3E3E40" />
    <SolidColorBrush x:Key="Pressed.Background" Color="#007ACC" />

    <!-- Input controls -->
    <SolidColorBrush x:Key="Control.Background" Color="#333337" />
    <SolidColorBrush x:Key="Control.Border" Color="#464649" />
    <SolidColorBrush x:Key="Control.Hover.Background" Color="#3E3E42" />
    <SolidColorBrush x:Key="Control.Disabled.Background" Color="#2D2D30" />

    <!-- Menus and popups -->
    <SolidColorBrush x:Key="Menu.Popup.Background" Color="#1B1B1C" />
    <SolidColorBrush x:Key="Menu.Popup.Border" Color="#3F3F46" />
    <SolidColorBrush x:Key="Menu.Separator" Color="#3F3F46" />

    <!-- Grids -->
    <SolidColorBrush x:Key="Grid.Header.Background" Color="#2D2D30" />
    <SolidColorBrush x:Key="Grid.Line" Color="#3F3F46" />

    <!-- Scroll bars -->
    <SolidColorBrush x:Key="Scroll.Background" Color="#3E3E42" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#686868" />
    <SolidColorBrush x:Key="Scroll.Thumb.Hover" Color="#9E9E9E" />
    <SolidColorBrush x:Key="Scroll.Thumb.Pressed" Color="#EFEBEF" />

    <!-- Icons -->
    <SolidColorBrush x:Key="Icon.Foreground" Color="#9BB7D4" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Semantic.Warning" Color="#DCDCAA" />
    <SolidColorBrush x:Key="Semantic.Error" Color="#F48771" />
    <SolidColorBrush x:Key="Semantic.Success" Color="#4EC9B0" />
    <SolidColorBrush x:Key="Semantic.Ascii" Color="#4EC9B0" />
    <SolidColorBrush x:Key="Semantic.Address" Color="#858585" />

    <!-- Code surfaces (AvalonEdit) -->
    <SolidColorBrush x:Key="Editor.Background" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Editor.Foreground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="Editor.LineNumbers" Color="#6E7681" />
    <SolidColorBrush x:Key="Editor.CurrentLine" Color="#28282D" />
    <SolidColorBrush x:Key="Editor.Selection" Color="#264F78" />

</ResourceDictionary>
