<Window x:Class="Spydate.App.Views.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant provider"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Panel.Background}"
        Foreground="{DynamicResource Text.Primary}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox x:Name="ProviderBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                  SelectionChanged="OnProviderChanged" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="API key" VerticalAlignment="Center" Margin="0,0,10,8" />
        <PasswordBox x:Name="KeyBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Endpoint" VerticalAlignment="Center" Margin="0,0,10,4" />
        <TextBox x:Name="EndpointBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" />

        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Tertiary}"
                   Text="Leave the endpoint empty unless you are going through a proxy or a compatible server." />

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,14"
                   Foreground="{DynamicResource Text.Tertiary}"
                   Text="The key is encrypted to your Windows account and kept apart from these settings, so it is not in any file you might share. It is sent only to the provider above. Everything the assistant reads comes from the binary you have open — treat what it reports the way you would treat the binary itself." />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Forget key" Width="92" Margin="0,0,8,0" Click="OnForgetClick" />
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="80" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
