<Window x:Class="Spydate.App.Views.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant provider"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Panel.Background}"
        Foreground="{DynamicResource Text.Primary}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox x:Name="ProviderBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                  SelectionChanged="OnProviderChanged" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,0,10,8" />
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
            <Button x:Name="FetchButton" DockPanel.Dock="Right" Content="List models" Width="90" Margin="6,0,0,0"
                    Click="OnFetchModelsClick"
                    ToolTip="Ask the provider which models it has. You can still type one it does not list."
                    AutomationProperties.Name="List models" />
            <!-- Editable: discovery is a convenience, not a gate. A model released today usually
                 works before it appears in a list, and a proxy may not implement the endpoint. -->
            <ComboBox x:Name="ModelBox" IsEditable="True" IsTextSearchEnabled="True"
                      AutomationProperties.Name="Model" />
        </DockPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="API key" VerticalAlignment="Center" Margin="0,0,10,8" />
        <PasswordBox x:Name="KeyBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Endpoint" VerticalAlignment="Center" Margin="0,0,10,4" />
        <TextBox x:Name="EndpointBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                 AutomationProperties.Name="Endpoint" />

        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Tertiary}"
                   Text="Leave the endpoint empty unless you are going through a proxy or a compatible server." />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Context" VerticalAlignment="Center" Margin="0,0,10,4" />
        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource Text.Tertiary}"
                       Text="thousand tokens" />
            <TextBox x:Name="ContextBox" Width="70" HorizontalAlignment="Left"
                     ToolTip="The model's context window, less room for its answer. Older exchanges are dropped to stay inside it."
                     AutomationProperties.Name="Context size" />
        </DockPanel>

        <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Tertiary}"
                   Text="Windows vary by more than ten times between models — 64 for most DeepSeek models, 200 for Claude, 1000 for Gemini. Too high does not fail cleanly, so leave headroom." />

        <CheckBox x:Name="StreamBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,10"
                  Content="Show the answer as it is written"
                  ToolTip="Turn this off if the assistant prints its own tool-call markup as text instead of running the tools."
                  AutomationProperties.Name="Stream the answer" />

        <!-- Across both columns, and not in the label column. That one is Auto-width, which measures
             at infinite width, so TextWrapping there does nothing: a provider's error would lay out
             on one line, widen the column past the whole dialog, squeeze the star column to nothing
             and leave the hint above wrapping one word per line.

             The height is fixed rather than capped, so the space is reserved whether or not there is
             anything to say. The window is SizeToContent, and a status line that appears out of
             nothing moves every control below it — including the buttons, at the moment someone is
             reaching for them. A long message scrolls inside this box instead. -->
        <ScrollViewer Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Height="52" Margin="0,0,0,10"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="ModelStatus" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.Tertiary}" />
        </ScrollViewer>

        <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,14"
                   Foreground="{DynamicResource Text.Tertiary}"
                   Text="The key is encrypted to your Windows account and kept apart from these settings, so it is not in any file you might share. It is sent only to the provider above. Everything the assistant reads comes from the binary you have open — treat what it reports the way you would treat the binary itself." />

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Forget key" Width="92" Margin="0,0,8,0" Click="OnForgetClick" />
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="80" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
