<Window x:Class="Spydate.App.Views.RunConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug Program"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Panel.Background}"
        Foreground="{DynamicResource Text.Primary}">

    <!-- How to run this binary: which debugger, what to start, with what, where, and where it should
         stop on its own. One decision made in one place, and remembered per binary — so it comes up
         filled in with whatever was used last time rather than asking again every session.

         Every box writes itself through as it is edited, which is why Close is not a cancel: what was
         typed is kept either way, and the only thing the buttons decide is whether to run now. -->
    <Grid Margin="14">
        <!-- Six rows: engine, executable, arguments, working directory, break at, and the buttons.
             The buttons keep a row of their own, spanning the width; sharing the Break at row once put
             them beside the chooser and squeezed it to half a box. A child placed in a row the Grid
             does not define is clamped into the last row that exists, so the count has to match. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Off for anything but an IL-only assembly, which is the only file that has a choice: one
             with native code of its own is debugged natively because that is where its instructions
             are, and the chooser shows Native and is off. Off during a run too — which debugger owns
             the process is settled when it starts. -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Debug engine" VerticalAlignment="Center" Margin="0,0,10,8" />
        <!-- An explicit template rather than DisplayMemberPath. The themed ComboBox supplies an
             ItemTemplate of its own, which takes precedence — so DisplayMemberPath was ignored and
             every row showed the record's ToString(): "EngineChoice { Native = False, Label = .NET
             CLR }". It compiled, it loaded, and only running it showed anything wrong. -->
        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                  ItemsSource="{Binding EngineChoices}"
                  SelectedValuePath="Native"
                  SelectedValue="{Binding DebugNatively, Mode=TwoWay}"
                  IsEnabled="{Binding CanChooseDebugger}"
                  ToolTip="Native drives a .NET program with the Win32 debugger, so breakpoints and patches can go into the native DLLs it loads — at the cost of managed frames, locals and IL stepping."
                  AutomationProperties.Name="Debug engine">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Off, and empty, for an EXE: it is its own executable and starts itself. On for a DLL
             (or a driver, or a .NET assembly whose launcher is a separate apphost), which is a module
             something else has to load — and that something is what this names. -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Executable" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                 Text="{Binding Host, UpdateSourceTrigger=LostFocus}"
                 IsEnabled="{Binding CanEditHost}"
                 Tag="none — the binary starts itself"
                 AutomationProperties.Name="Executable" />
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,8"
                    IsEnabled="{Binding CanEditHost}">
            <Button Content="…" Width="28" Command="{Binding ChooseHostCommand}"
                    AutomationProperties.Name="Choose executable" />
            <Button Content="Clear" Width="52" Margin="4,0,0,0" Command="{Binding ClearHostCommand}"
                    AutomationProperties.Name="Clear executable" />
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Arguments" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                 Text="{Binding Arguments, UpdateSourceTrigger=LostFocus}"
                 IsEnabled="{Binding CanEditRun}"
                 AutomationProperties.Name="Arguments" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Working directory" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                 Text="{Binding WorkingDirectory, UpdateSourceTrigger=LostFocus}"
                 IsEnabled="{Binding CanEditRun}"
                 Tag="the host's own folder"
                 AutomationProperties.Name="Working directory" />
        <Button Grid.Row="3" Grid.Column="2" Content="…" Width="28" Margin="6,0,0,8"
                Command="{Binding ChooseWorkingDirectoryCommand}"
                IsEnabled="{Binding CanEditRun}"
                AutomationProperties.Name="Choose working directory" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Break at" VerticalAlignment="Center" Margin="0,0,10,14" />
        <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                  ItemsSource="{Binding BreakAtChoices}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding BreakAt, Mode=TwoWay}"
                  IsEnabled="{Binding CanEditRun}"
                  ToolTip="Where the run stops by itself, before any breakpoint of your own."
                  AutomationProperties.Name="Break at">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Their own row, spanning the width. Sharing the Break at row put them beside the chooser
             and squeezed it to half a box. -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Debug" Width="80" IsDefault="True" Click="OnDebug"
                    IsEnabled="{Binding CanEditRun}"
                    AutomationProperties.Name="Debug" />
            <Button Content="Close" Width="80" Margin="6,0,0,0" IsCancel="True"
                    AutomationProperties.Name="Close" />
        </StackPanel>
    </Grid>
</Window>
