<ui:FluentWindow x:Class="Spydate.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Spydate.App.ViewModels"
                 xmlns:docs="clr-namespace:Spydate.App.ViewModels.Documents"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="{Binding WindowTitle}"
                 Width="1280" Height="800" MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Default"
                 Background="{DynamicResource Chrome.Background}"
                 Foreground="{DynamicResource Text.Primary}"
                 FontFamily="{DynamicResource App.FontFamily}"
                 FontSize="{DynamicResource App.FontSize}"
                 AllowDrop="True"
                 Drop="OnDrop" DragOver="OnDragOver">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveDocumentCommand}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseActiveDocumentCommand}" />
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding FocusGotoCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F5" Command="{Binding ReanalyzeCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameSymbolCommand}" />
        <KeyBinding Key="OemSemicolon" Modifiers="Control" Command="{Binding EditCommentCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PatchCommand}" />
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding TestPatchLiveCommand}" />
        <KeyBinding Key="F9" Command="{Binding ToggleBreakpointCommand}" />
        <KeyBinding Key="F8" Command="{Binding Debugger.ContinueCommand}" />
        <KeyBinding Key="F10" Command="{Binding Debugger.StepOverCommand}" />
        <KeyBinding Key="F10" Modifiers="Control" Command="{Binding RunToCursorCommand}" />
        <KeyBinding Key="F11" Command="{Binding Debugger.StepInstructionCommand}" />
        <KeyBinding Key="F11" Modifiers="Control" Command="{Binding Debugger.StepIlCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding Debugger.StopDebuggingCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding NavigateBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NavigateForwardCommand}" />
        <KeyBinding Key="F6" Command="{Binding OpenSideBySideCommand}" />
        <KeyBinding Key="F7" Command="{Binding OpenGraphCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Title bar ============================ -->
        <ui:TitleBar Grid.Row="0" Height="28" Title="{Binding WindowTitle}"
                     Background="{DynamicResource Chrome.Background}"
                     Foreground="{DynamicResource Text.Primary}"
                     ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <!-- Pulled left to sit on the same edge as File below it. The TitleBar gives its
                     icon a wider inset than a Menu gives its first item (10 = Menu padding 2 plus
                     item padding 8), and the two controls know nothing of each other. -->
                <ui:SymbolIcon Symbol="Bug24" FontSize="14" Margin="-6.67,0,0,0" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============================== Menu =============================== -->
        <Border Grid.Row="1" Background="{DynamicResource Chrome.Background}">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Command="{Binding OpenFileCommand}" />

                    <!-- Each row carries its own command, so nothing here has to reach back up the
                         tree: a submenu lives in its own popup, where RelativeSource to the window
                         is not dependable. -->
                    <MenuItem Header="Open _recent" ItemsSource="{Binding Recent}"
                              IsEnabled="{Binding HasRecent}" AutomationProperties.Name="Open recent">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <!-- The folder sits where a shortcut usually would: dimmed, right
                                     aligned, and the thing that tells two setup.exe files apart. -->
                                <Setter Property="InputGestureText" Value="{Binding Folder}" />
                                <Setter Property="ToolTip" Value="{Binding Path}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                                <Setter Property="CommandParameter" Value="{Binding Path}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>

                    <MenuItem Header="C_lear recent" Command="{Binding ClearRecentCommand}"
                              IsEnabled="{Binding HasRecent}" />

                    <MenuItem Header="_Save project" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                    <MenuItem Header="Save _patched copy…" Command="{Binding SavePatchedCommand}"
                              IsEnabled="{Binding HasPatches}"
                              ToolTip="Writes a new file with the patches applied. The original is never modified." />
                    <MenuItem Header="_Close file" Command="{Binding CloseFileCommand}" />
                    <Separator />
                    <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExitClick" />
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="_Rename…" InputGestureText="F2" Command="{Binding RenameSymbolCommand}" />
                    <MenuItem Header="Comment…" InputGestureText="Ctrl+;" Command="{Binding EditCommentCommand}" />
                    <Separator />
                    <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" />
                    <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Command="ApplicationCommands.SelectAll" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Explorer" IsCheckable="True"
                              IsChecked="{Binding IsExplorerVisible, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <MenuItem Header="_Output" IsCheckable="True"
                              IsChecked="{Binding IsOutputVisible, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Separator />
                    <Separator />
                    <MenuItem Header="_Side by side" InputGestureText="F6" Command="{Binding OpenSideBySideCommand}"
                              ToolTip="Show this function's disassembly and pseudo-C together, each following the other" />
                    <MenuItem Header="Control-flow _graph" InputGestureText="F7" Command="{Binding OpenGraphCommand}"
                              ToolTip="Draw this function as basic blocks and the edges between them" />
                    <Separator />
                    <MenuItem Header="Assistant _provider…" Command="{Binding Assistant.ConfigureCommand}"
                              ToolTip="Choose a provider and model for the Assistant panel, and add an API key" />
                    <Separator />
                    <MenuItem Header="Close _tab" InputGestureText="Ctrl+W" Command="{Binding CloseActiveDocumentCommand}" />
                    <MenuItem Header="Close all tabs" Command="{Binding CloseAllDocumentsCommand}" />
                </MenuItem>
                <MenuItem Header="_Analyze">
                    <MenuItem Header="_Back" InputGestureText="Alt+Left" Command="{Binding NavigateBackCommand}" />
                    <MenuItem Header="_Forward" InputGestureText="Alt+Right" Command="{Binding NavigateForwardCommand}" />
                    <Separator />
                    <MenuItem Header="_Go to address…" InputGestureText="Ctrl+G"
                              Command="{Binding FocusGotoCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <MenuItem Header="Go to _entry point" Command="{Binding OpenEntryPointCommand}" />
                    <Separator />
                    <!-- Patches act on the address the active document is showing. Nothing is written
                         to disk until File ▸ Save patched copy. -->
                    <MenuItem Header="_NOP out this instruction" Command="{Binding NopOutCommand}"
                              ToolTip="Replaces the instruction here with NOPs of exactly the same length" />
                    <MenuItem Header="_Patch instruction…" InputGestureText="Ctrl+P" Command="{Binding PatchCommand}"
                              ToolTip="Type an instruction to put at the caret" />
                    <MenuItem Header="_Invert this branch" Command="{Binding InvertBranchCommand}"
                              ToolTip="Makes a conditional jump take the other way, keeping its length" />
                    <Separator />
                    <MenuItem Header="_Re-analyze" InputGestureText="F5" Command="{Binding ReanalyzeCommand}" />
                </MenuItem>

                <!-- F5 is already Re-analyze and has been since before there was a debugger, so
                     these avoid it rather than quietly changing what a familiar key does. -->
                <MenuItem Header="_Debug">
                    <MenuItem Header="_Run under the debugger…" Command="{Binding Debugger.StartCommand}"
                              ToolTip="Starts the open binary on this machine. It will do whatever it does." />
                    <!-- Beside Run rather than off on its own, because it is a choice about how the
                         run will be done and is settled the moment one starts. Only for an IL-only
                         assembly: everything else is native already. -->
                    <MenuItem Header="Debug _natively" IsCheckable="True"
                              IsChecked="{Binding Debugger.DebugNatively, Mode=TwoWay}"
                              IsEnabled="{Binding Debugger.CanChooseDebugger}"
                              ToolTip="Drive this .NET program with the native debugger, so breakpoints and patches can go into the native DLLs it loads. No managed frames, locals or IL stepping in this mode." />
                    <MenuItem Header="_Stop" InputGestureText="Shift+F5" Command="{Binding Debugger.StopDebuggingCommand}" />
                    <Separator />
                    <MenuItem Header="_Continue" InputGestureText="F8" Command="{Binding Debugger.ContinueCommand}" />
                    <MenuItem Header="_Pause" Command="{Binding Debugger.PauseCommand}"
                              ToolTip="Stops it where it is, without ending it" />
                    <MenuItem Header="Step _over" InputGestureText="F10" Command="{Binding Debugger.StepOverCommand}"
                              ToolTip="Runs a call to completion instead of stepping into it" />
                    <MenuItem Header="Step _into" InputGestureText="F11" Command="{Binding Debugger.StepInstructionCommand}"
                              ToolTip="One statement, stopping inside any call it makes. One machine instruction, for a native process." />
                    <MenuItem Header="Step one I_L instruction" InputGestureText="Ctrl+F11" Command="{Binding Debugger.StepIlCommand}"
                              ToolTip="One IL instruction, for reading the IL view. .NET processes only." />
                    <MenuItem Header="Run to c_ursor" InputGestureText="Ctrl+F10" Command="{Binding RunToCursorCommand}" />
                    <Separator />
                    <MenuItem Header="_Test patch live…" InputGestureText="Ctrl+Shift+P" Command="{Binding TestPatchLiveCommand}"
                              ToolTip="Assemble an instruction into the running process as a hypothesis, to Keep or Undo" />
                    <Separator />
                    <MenuItem Header="Toggle _breakpoint" InputGestureText="F9" Command="{Binding ToggleBreakpointCommand}"
                              ToolTip="Marks the line the caret is on. Works before anything is running." />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_About Spydate" Click="OnAboutClick" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ============================= Toolbar ============================= -->
        <Border Grid.Row="2" Style="{StaticResource ToolStrip}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding OpenFileCommand}" AutomationProperties.Name="Open"
                        ToolTip="Open a PE file (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="Open" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding CloseFileCommand}" AutomationProperties.Name="Close file"
                        IsEnabled="{Binding HasBinary}" ToolTip="Close the current file">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="Close" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolSeparator}" />

                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding NavigateBackCommand}"
                        AutomationProperties.Name="Back" ToolTip="{Binding BackTooltip}">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" />
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding NavigateForwardCommand}"
                        AutomationProperties.Name="Forward" ToolTip="{Binding ForwardTooltip}">
                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" />
                </Button>

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolSeparator}" />

                <TextBlock DockPanel.Dock="Left" Text="Address:" VerticalAlignment="Center" Margin="2,0,4,0"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBox x:Name="GotoBox" DockPanel.Dock="Left" Width="220" AutomationProperties.Name="Address"
                         Tag="VA / RVA / offset / symbol"
                         FontFamily="{DynamicResource Mono.FontFamily}"
                         Text="{Binding GotoAddressText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding HasBinary}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding GoToAddressCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="Go" Margin="3,0,0,0" AutomationProperties.Name="Go"
                        Command="{Binding GoToAddressCommand}" IsEnabled="{Binding HasBinary}" />

                <Border DockPanel.Dock="Left" Style="{StaticResource ToolSeparator}" />

                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding OpenEntryPointCommand}" AutomationProperties.Name="Go to entry point"
                        IsEnabled="{Binding HasBinary}" ToolTip="Disassemble the entry point">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="Entry point" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Command="{Binding ReanalyzeCommand}" AutomationProperties.Name="Re-analyze"
                        IsEnabled="{Binding HasBinary}" ToolTip="Re-run function discovery (F5)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="Re-analyze" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ============================ Main area ============================ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="280" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Explorer tool window -->
            <Border x:Name="ExplorerPanel" Grid.Column="0" Style="{StaticResource ToolWindow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource ToolWindowHeader}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="&#x2715;"
                                    Margin="0,0,3,0" ToolTip="Hide the explorer (View ▸ Explorer)"
                                    Click="OnHideExplorerClick" AutomationProperties.Name="Hide explorer" />
                            <TextBlock Style="{StaticResource ToolWindowHeaderText}" Text="Explorer" />
                        </DockPanel>
                    </Border>

                    <TreeView x:Name="ExplorerTree" Grid.Row="1" ItemsSource="{Binding Explorer}"
                              SelectedItemChanged="OnExplorerSelectionChanged" Padding="0,2,0,0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Subtitle}" Margin="0,0,4,0">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="12" Margin="0,0,4,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Icon.Foreground}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Subtitle}" VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontSize="{DynamicResource Small.FontSize}"
                                               Foreground="{DynamicResource Text.Tertiary}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"
                                Visibility="{Binding HasBinary, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="No file loaded" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}" />
                        <TextBlock Text="File ▸ Open, or drop a PE file here" HorizontalAlignment="Center" Margin="0,3,0,0"
                                   FontSize="{DynamicResource Small.FontSize}"
                                   Foreground="{DynamicResource Text.Tertiary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- Documents + output -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="OutputRow" Height="170" MinHeight="0" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TabControl ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                                Style="{StaticResource DocumentTabControl}"
                                Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisibility}}">
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type docs:DocumentViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="&#x25CF;" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="8"
                                               Foreground="{DynamicResource Accent.Hover}"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource TabCloseButton}" ToolTip="Close (Ctrl+W)" AutomationProperties.Name="Close tab"
                                            Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>

                    <Border Background="{DynamicResource Document.Background}"
                            Visibility="{Binding HasDocuments, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Select an item in the explorer to open a document."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Tertiary}" />
                    </Border>
                </Grid>

                <GridSplitter x:Name="OutputSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

                <!-- Output tool window -->
                <Border x:Name="OutputPanel" Grid.Row="2" Style="{StaticResource ToolWindow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource ToolWindowHeader}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="&#x2715;"
                                        Margin="0,0,3,0" ToolTip="Hide the output panel (View ▸ Output)"
                                        Click="OnHideOutputClick" AutomationProperties.Name="Hide output" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource GlyphButton}" Content="&#x2327;"
                                        Margin="0,0,2,0" ToolTip="Clear" Command="{Binding ClearOutputCommand}" AutomationProperties.Name="Clear output" />
                                <TextBlock Style="{StaticResource ToolWindowHeaderText}"
                                           Text="{Binding SelectedItem.Header, ElementName=BottomTabs}" />
                            </DockPanel>
                        </Border>

                        <TabControl x:Name="BottomTabs" Grid.Row="1" Style="{StaticResource BottomTabControl}">
                            <TabItem Header="Output">
                                <ListBox x:Name="OutputList" ItemsSource="{Binding Output}" />
                            </TabItem>
                            <TabItem Header="{Binding XrefsCaption}">
                                <Grid>
                                    <DataGrid x:Name="XrefGrid" ItemsSource="{Binding Xrefs}" Style="{StaticResource DocGrid}"
                                              Background="{DynamicResource Panel.Background}"
                                              MouseDoubleClick="OnXrefDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Address" Binding="{Binding From}" Width="130" />
                                            <DataGridTextColumn Header="In function" Binding="{Binding Function}" Width="240" />
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
                                            <DataGridTextColumn Header="Instruction" Binding="{Binding Instruction}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Open a function to see what references it."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Tertiary}"
                                               Visibility="{Binding Xrefs.Count, Converter={StaticResource ZeroToVisible}}" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Warnings">
                                <ListBox ItemsSource="{Binding Warnings}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                                       Foreground="{DynamicResource Semantic.Warning}"
                                                       FontFamily="{DynamicResource Mono.FontFamily}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                            <TabItem Header="Debug">
                                <Grid DataContext="{Binding Debugger}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- One row: what you can do, then what you can look at. The
                                         actions are icons because there are five of them and they
                                         are the same five in every debugger ever made; a row of
                                         words for them costs the width the panes need. What to run
                                         and how has gone behind the ⋮ - it is set once for a binary
                                         and then never touched, and it was taking a whole row from
                                         the things that change every time execution stops. -->
                                    <Border Grid.Row="0" Style="{StaticResource ToolStrip}">
                                        <DockPanel LastChildFill="False">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                                    Command="{Binding StartCommand}"
                                                    ToolTip="Run under the debugger"
                                                    AutomationProperties.Name="Run under the debugger">
                                                <ui:SymbolIcon Symbol="Play20" Foreground="{DynamicResource Semantic.Success}" />
                                            </Button>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                                    Command="{Binding ContinueCommand}"
                                                    ToolTip="Continue (F8)"
                                                    AutomationProperties.Name="Continue running">
                                                <ui:SymbolIcon Symbol="FastForward20" />
                                            </Button>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                                    Command="{Binding PauseCommand}"
                                                    ToolTip="Pause - stop it where it is, without ending it"
                                                    AutomationProperties.Name="Pause">
                                                <ui:SymbolIcon Symbol="Pause20" />
                                            </Button>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                                    Command="{Binding StepOverCommand}"
                                                    ToolTip="Step over (F10)"
                                                    AutomationProperties.Name="Step over">
                                                <ui:SymbolIcon Symbol="ArrowStepOver20" />
                                            </Button>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                                    Command="{Binding StepInstructionCommand}"
                                                    ToolTip="Step one instruction (F11)"
                                                    AutomationProperties.Name="Step one instruction">
                                                <ui:SymbolIcon Symbol="ArrowStepIn20" />
                                            </Button>
                                            <!-- Managed only, and not an oversight on the native
                                                 side: stepping out of a native function means
                                                 knowing where its return address is, which is a
                                                 question about an unwinding convention rather than
                                                 about the program. The runtime already knows. -->
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                                    Command="{Binding StepOutCommand}"
                                                    Visibility="{Binding UsesManagedDebugger, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="Step out — run to the end of this method"
                                                    AutomationProperties.Name="Step out">
                                                <ui:SymbolIcon Symbol="ArrowStepOut20" />
                                            </Button>
                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                                    Command="{Binding StopDebuggingCommand}"
                                                    ToolTip="Stop, which ends the process (Shift+F5)"
                                                    AutomationProperties.Name="Stop debugging">
                                                <ui:SymbolIcon Symbol="Stop20" Foreground="{DynamicResource Semantic.Error}" />
                                            </Button>

                                            <Border DockPanel.Dock="Left" Width="1" Margin="6,4"
                                                    Background="{DynamicResource Chrome.Border}" />

                                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                                    Command="{Binding ConfigureRunCommand}"
                                                    ToolTip="Run configuration — the host, its arguments and where to start it"
                                                    AutomationProperties.Name="Run configuration">
                                                <ui:SymbolIcon Symbol="MoreVertical20" />
                                            </Button>

                                            <!-- Only for an IL-only assembly, and only before it
                                                 starts: which debugger owns the process is settled
                                                 when the session is made, and the two cannot both
                                                 attach. Ticked, a .NET program is driven by the
                                                 native loop, which is the only way to stop in or
                                                 patch the native DLLs it loads — at the cost of
                                                 there being no managed frame or locals, because
                                                 nothing is then talking to the runtime. -->
                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                                      Content="Native"
                                                      IsChecked="{Binding DebugNatively, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanChooseDebugger}"
                                                      Visibility="{Binding IsManaged, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="Debug this .NET program with the native debugger, so breakpoints and patches can go into the native DLLs it loads. No managed frames, locals or IL stepping in this mode."
                                                      AutomationProperties.Name="Debug natively" />

                                            <Border DockPanel.Dock="Left" Width="1" Margin="6,4"
                                                    Background="{DynamicResource Chrome.Border}" />

                                            <!-- Tabs on the same row as the actions, so the panes
                                                 below get the whole of the height there is. -->
                                            <!-- One of these two is showing at a time, decided by
                                                 what was opened. Registers and stack words are what
                                                 a native stop has to say; a managed stop has the
                                                 frame's own values, which is the same question
                                                 answered by something that knows the answer. -->
                                            <RadioButton x:Name="PaneThreads" DockPanel.Dock="Left"
                                                         Style="{StaticResource StripTab}" IsChecked="True"
                                                         Content="Threads &amp; registers"
                                                         Visibility="{Binding ShowsRegisters, Converter={StaticResource BoolToVisibility}}"
                                                         AutomationProperties.Name="Threads and registers" />
                                            <RadioButton x:Name="PaneLocals" DockPanel.Dock="Left"
                                                         Style="{StaticResource StripTab}" Content="Locals"
                                                         IsChecked="{Binding UsesManagedDebugger, Mode=OneWay}"
                                                         Visibility="{Binding UsesManagedDebugger, Converter={StaticResource BoolToVisibility}}"
                                                         ToolTip="Arguments and locals of the frame being looked at. Open a row to see inside it."
                                                         AutomationProperties.Name="Locals pane" />
                                            <RadioButton x:Name="PaneCallStack" DockPanel.Dock="Left"
                                                         Style="{StaticResource StripTab}" Content="Call stack"
                                                         Visibility="{Binding UsesManagedDebugger, Converter={StaticResource BoolToVisibility}}"
                                                         ToolTip="The frames of the thread being looked at. Pick one to read its locals."
                                                         AutomationProperties.Name="Call stack pane" />
                                            <RadioButton x:Name="PaneManagedThreads" DockPanel.Dock="Left"
                                                         Style="{StaticResource StripTab}" Content="Threads"
                                                         Visibility="{Binding UsesManagedDebugger, Converter={StaticResource BoolToVisibility}}"
                                                         ToolTip="Every thread in the process. Pick one to read its values and step it."
                                                         AutomationProperties.Name="Managed threads pane" />
                                            <RadioButton x:Name="PaneModules" DockPanel.Dock="Left"
                                                         Style="{StaticResource StripTab}" Content="Modules"
                                                         AutomationProperties.Name="Modules pane" />
                                            <RadioButton x:Name="PaneLog" DockPanel.Dock="Left"
                                                         Style="{StaticResource StripTab}" Content="Log"
                                                         AutomationProperties.Name="Log pane" />
                                            <RadioButton x:Name="PaneLivePatches" DockPanel.Dock="Left"
                                                         Style="{StaticResource StripTab}" Content="Live patches"
                                                         ToolTip="Patches tried in the running process but not yet in the project"
                                                         AutomationProperties.Name="Live patches pane" />

                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Flags}"
                                                       VerticalAlignment="Center" Margin="12,0,6,0"
                                                       FontFamily="{DynamicResource Mono.FontFamily}"
                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                       ToolTip="Processor flags at the last stop" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Text.Secondary}" />
                                        </DockPanel>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <!-- Threads beside registers beside the stack, which is the
                                             one grouping worth having together: which thread stopped,
                                             what it was holding, and what it had called. -->
                                        <Grid Visibility="{Binding IsChecked, ElementName=PaneThreads, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="250" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <DataGrid Grid.Column="0" ItemsSource="{Binding Threads}" AutoGenerateColumns="False"
                                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                                      SelectedItem="{Binding SelectedThread, Mode=TwoWay}"
                                                      SelectionMode="Single" SelectionUnit="FullRow"
                                                      ToolTip="Pick a thread to read its registers and to step it"
                                                      AutomationProperties.Name="Threads">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="tid" Binding="{Binding Id}">
                                                        <DataGridTextColumn.CellStyle>
                                                            <Style TargetType="DataGridCell">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Debug.Current}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGridTextColumn.CellStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="state" Binding="{Binding Doing}"
                                                                        Foreground="{DynamicResource Text.Tertiary}" />
                                                    <DataGridTextColumn Header="started at" Binding="{Binding Start}"
                                                                        FontFamily="{DynamicResource Mono.FontFamily}" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                                          Background="{DynamicResource Chrome.Border}" />

                                            <DataGrid Grid.Column="2" ItemsSource="{Binding Registers}" AutoGenerateColumns="False"
                                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                                      AutomationProperties.Name="Registers">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="reg" Binding="{Binding Name}" />
                                                    <DataGridTextColumn Header="value" Binding="{Binding Value}"
                                                                        FontFamily="{DynamicResource Mono.FontFamily}">
                                                        <DataGridTextColumn.CellStyle>
                                                            <Style TargetType="DataGridCell">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Debug.Breakpoint}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataGridTextColumn.CellStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                                                          Background="{DynamicResource Chrome.Border}" />

                                            <DataGrid Grid.Column="4" ItemsSource="{Binding Stack}" AutoGenerateColumns="False"
                                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                                      FontFamily="{DynamicResource Mono.FontFamily}"
                                                      AutomationProperties.Name="Stack">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="stack" Binding="{Binding Address}" />
                                                    <DataGridTextColumn Header="value" Binding="{Binding Value}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>

                                        <!-- What the stopped frame is holding, which is the thing the
                                             native debugger cannot say. It can report rcx; this can
                                             report the path being opened, because the runtime knows
                                             what every slot is. -->
                                        <!-- Name, Value, Type, as every Locals window lays them out. A flat
                                             grid with indentation rather than a TreeView, so the three
                                             columns line up however deep a row is. Opening a row
                                             reads its children from the process at that moment. -->
                                        <DataGrid ItemsSource="{Binding Variables}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                                  CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                                  EnableRowVirtualization="True"
                                                  Visibility="{Binding IsChecked, ElementName=PaneLocals, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="Locals and arguments">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Name" Width="240">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                                                <ToggleButton Width="16" Height="16" Focusable="False" Cursor="Hand"
                                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              AutomationProperties.Name="Expand">
                                                                    <ToggleButton.Style>
                                                                        <Style TargetType="ToggleButton">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                                        <Border Background="Transparent">
                                                                                            <TextBlock x:Name="Chevron" Text="&#x25B6;" FontSize="8"
                                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                       Foreground="{DynamicResource Text.Secondary}"
                                                                                                       RenderTransformOrigin="0.5,0.5" />
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                                                                    <Setter.Value>
                                                                                                        <RotateTransform Angle="90" />
                                                                                                    </Setter.Value>
                                                                                                </Setter>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <!-- Hidden, not collapsed: the space stays, so a leaf's
                                                                                     name lines up with its expandable siblings. -->
                                                                                <DataTrigger Binding="{Binding Expandable}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ToggleButton.Style>
                                                                </ToggleButton>
                                                                <TextBlock Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Text.Primary}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Value" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       FontFamily="{DynamicResource Mono.FontFamily}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Value.String}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Character">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Value.String}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Keyword">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Value.Keyword}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Null">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Value.Keyword}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Number">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Value.Number}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Object">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Value.Type}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Enum">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Value.Enum}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Unavailable">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                                                            </DataTrigger>
                                                                            <!-- A property not yet run, or one that threw. A resolved value takes
                                                                                 its real kind's colour instead. -->
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Property">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="320"
                                                                    Foreground="{DynamicResource Value.Type}" />
                                            </DataGrid.Columns>
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Set value…"
                                                              Command="{Binding PlacementTarget.DataContext.SetVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                        </DataGrid>

                                        <!-- Every thread, as a Threads window shows them. Picking one moves
                                             the values, the arrow and stepping to it. -->
                                        <!-- The call stack, innermost first. Picking a frame moves the
                                             locals and the arrow to it. -->
                                        <DataGrid ItemsSource="{Binding CallStack}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                                  SelectedItem="{Binding SelectedCallFrame, Mode=TwoWay}"
                                                  CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                                  Visibility="{Binding IsChecked, ElementName=PaneCallStack, Converter={StaticResource BoolToVisibility}}"
                                                  ToolTip="Pick a frame to read its locals"
                                                  AutomationProperties.Name="Call stack">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="18">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="&#x25B6;" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Debug.Current}"
                                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Frame" Binding="{Binding Display}" Width="*"
                                                                    FontFamily="{DynamicResource Mono.FontFamily}">
                                                    <DataGridTextColumn.CellStyle>
                                                        <Style TargetType="DataGridCell">
                                                            <Style.Triggers>
                                                                <!-- A native or runtime frame is greyed: there is nothing to read in it. -->
                                                                <DataTrigger Binding="{Binding IsManaged}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.CellStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <DataGrid ItemsSource="{Binding ManagedThreads}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                                  SelectedItem="{Binding SelectedManagedThread, Mode=TwoWay}"
                                                  CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                                  Visibility="{Binding IsChecked, ElementName=PaneManagedThreads, Converter={StaticResource BoolToVisibility}}"
                                                  ToolTip="Pick a thread to read its values and step it"
                                                  AutomationProperties.Name="Managed threads">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="18">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="&#x25B6;" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Debug.Current}"
                                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="ID" Binding="{Binding IdText}"
                                                                    FontFamily="{DynamicResource Mono.FontFamily}" />
                                                <DataGridTextColumn Header="Managed ID" Binding="{Binding ManagedId}" />
                                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" />
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"
                                                                    Foreground="{DynamicResource Value.Type}" />
                                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" />
                                                <DataGridTextColumn Header="AppDomain" Binding="{Binding AppDomain}" />
                                                <DataGridTextColumn Header="State" Binding="{Binding State}"
                                                                    Foreground="{DynamicResource Text.Secondary}" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <DataGrid ItemsSource="{Binding Modules}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                                  Visibility="{Binding IsChecked, ElementName=PaneModules, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="Loaded modules">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="module" Binding="{Binding Name}">
                                                    <DataGridTextColumn.CellStyle>
                                                        <Style TargetType="DataGridCell">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Debug.Current}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.CellStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="base" Binding="{Binding Base}"
                                                                    FontFamily="{DynamicResource Mono.FontFamily}" />
                                                <DataGridTextColumn Header="path" Binding="{Binding Path}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <ListBox ItemsSource="{Binding Log}"
                                                 FontFamily="{DynamicResource Mono.FontFamily}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Visibility="{Binding IsChecked, ElementName=PaneLog, Converter={StaticResource BoolToVisibility}}"
                                                 AutomationProperties.Name="Debug log" />

                                        <!-- Hypotheses: bytes that are in the process but not the project.
                                             Keep writes one into the project; Undo takes it back out. -->
                                        <DataGrid ItemsSource="{Binding LivePatches}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                                  SelectionMode="Single"
                                                  Visibility="{Binding IsChecked, ElementName=PaneLivePatches, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="Live patches">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="address" Binding="{Binding Where}"
                                                                    FontFamily="{DynamicResource Mono.FontFamily}" />
                                                <DataGridTextColumn Header="was" Binding="{Binding Was}"
                                                                    FontFamily="{DynamicResource Mono.FontFamily}" />
                                                <DataGridTextColumn Header="now" Binding="{Binding Now}"
                                                                    FontFamily="{DynamicResource Mono.FontFamily}" />
                                                <DataGridTextColumn Header="why" Binding="{Binding Comment}" Width="*" />
                                            </DataGrid.Columns>
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Keep (write into the project)"
                                                              Command="{Binding PlacementTarget.DataContext.KeepPatchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Undo (take out of the process)"
                                                              Command="{Binding PlacementTarget.DataContext.UndoPatchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="{Binding PatchesCaption}">
                                <DataGrid ItemsSource="{Binding Patches}" AutoGenerateColumns="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="None" SelectionMode="Single"
                                          AutomationProperties.Name="Patches">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="RVA" Binding="{Binding Rva, StringFormat=0x{0:X}}" />
                                        <DataGridTextColumn Header="Was" Binding="{Binding OriginalHex}"
                                                            FontFamily="{DynamicResource Mono.FontFamily}" />
                                        <DataGridTextColumn Header="Now" Binding="{Binding Hex}"
                                                            FontFamily="{DynamicResource Mono.FontFamily}" />
                                        <DataGridTextColumn Header="On" Binding="{Binding Enabled}" />
                                        <DataGridTextColumn Header="Why" Binding="{Binding Comment}" Width="*" />
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Switch on or off"
                                                      Command="{Binding PlacementTarget.DataContext.TogglePatchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Revert"
                                                      Command="{Binding PlacementTarget.DataContext.RevertPatchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Assistant">
                                <Grid DataContext="{Binding Assistant}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource ToolStrip}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Configure"
                                                    Command="{Binding ConfigureCommand}"
                                                    ToolTip="Choose a provider and add an API key"
                                                    AutomationProperties.Name="Configure assistant" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Clear"
                                                    Command="{Binding StartOverCommand}"
                                                    ToolTip="Empty this conversation, keeping the others"
                                                    AutomationProperties.Name="Clear assistant" />

                                            <!-- Which conversation about this binary you are in. One
                                                 program is rarely one question, and two faults
                                                 chased in one transcript spend the model's context
                                                 on whichever it is not being asked about. Titled by
                                                 the question each opened with, which is what the
                                                 reader went in to find out and so what they look
                                                 for coming back. -->
                                            <ComboBox DockPanel.Dock="Right" Width="190" Margin="0,0,3,0"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding Sessions}"
                                                      SelectedItem="{Binding ActiveSession, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsIdle}"
                                                      ToolTip="Which conversation about this binary you are in"
                                                      AutomationProperties.Name="Assistant chat session">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="New"
                                                    Command="{Binding NewSessionCommand}"
                                                    ToolTip="Start another conversation about this binary"
                                                    AutomationProperties.Name="New assistant chat" />

                                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Foreground="{DynamicResource Text.Secondary}" />
                                        </DockPanel>
                                    </Border>

                                    <!-- A read-only RichTextBox rather than a list of TextBlocks: an
                                         answer needs headings, code and lists to be readable, and
                                         needs to be selectable so it can be copied out. It also
                                         scrolls by content rather than by item, which a transcript
                                         of wrapped variable-height paragraphs never did reliably. -->
                                    <RichTextBox Grid.Row="1" x:Name="AssistantTranscript"
                                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                 IsDocumentEnabled="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 Foreground="{DynamicResource Text.Primary}"
                                                 AutomationProperties.Name="Assistant transcript">
                                        <!-- Zero, and the inset lives on the blocks instead - see
                                             MarkdownFlow.Inset. A RichTextBox manages its own
                                             document's padding, so a value set here is not reliably
                                             what you get; the gap on the right went missing exactly
                                             because it was asked for in this one place. A margin on
                                             a Block is the author's and nothing overrides it. -->
                                        <RichTextBox.Document>
                                            <FlowDocument PagePadding="0" />
                                        </RichTextBox.Document>
                                    </RichTextBox>

                                    <DockPanel Grid.Row="2" Margin="4">
                                        <!-- One button in one place, not two that trade places. Ask
                                             and Stop are never both available, so a second button is
                                             either disabled or absent - and a control that appears
                                             under the pointer, at the moment a slow turn starts, is
                                             one that gets clicked by accident. -->
                                        <Button DockPanel.Dock="Right" Width="66" Margin="6,0,0,0" VerticalAlignment="Bottom"
                                                AutomationProperties.Name="Ask or stop the assistant">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Ask" />
                                                    <Setter Property="Command" Value="{Binding AskCommand}" />
                                                    <Setter Property="ToolTip" Value="Send the question" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Content" Value="Stop" />
                                                            <Setter Property="Command" Value="{Binding StopCommand}" />
                                                            <Setter Property="ToolTip" Value="Stop this turn" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Beside the box rather than at the top of the panel: this
                                             is about the question just typed, and a fixed width so
                                             the box does not shift as the word changes. -->
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Activity}"
                                                   Width="62" VerticalAlignment="Bottom" Margin="2,0,6,3"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   AutomationProperties.Name="Assistant activity" />

                                        <!-- Off while a turn runs, so it is visible that the question
                                             went somewhere and a second one is not wanted yet.

                                             AcceptsReturn is what lets a pasted listing arrive as the
                                             several lines it is: without it the box keeps the first
                                             line and drops the rest, silently. Enter still asks -
                                             OnAssistantKeyDown handles it, and Shift+Enter breaks
                                             the line - and it grows to a few lines before scrolling. -->
                                        <TextBox x:Name="AssistantQuestion" Tag="Ask about the binary, or tell it what to name"
                                                 Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsIdle}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                                 PreviewKeyDown="OnAssistantKeyDown"
                                                 AutomationProperties.Name="Assistant question" />
                                    </DockPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- =========================== Status bar ============================ -->
        <Border Grid.Row="4" Background="{DynamicResource Chrome.Background}"
                BorderBrush="{DynamicResource Chrome.Border}" BorderThickness="0,1,0,0">
            <Grid Height="21">
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="2"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <DockPanel Margin="6,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AnalysisText}" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
