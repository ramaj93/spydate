<UserControl x:Class="Spydate.App.Views.Documents.HexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:docs="clr-namespace:Spydate.App.ViewModels.Documents"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=docs:HexDocumentViewModel}"
             DataContextChanged="OnDataContextChanged"
             Background="{DynamicResource Document.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolStrip}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Go to:" VerticalAlignment="Center" Margin="2,0,4,0"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBox DockPanel.Dock="Left" Width="170" Tag="offset / RVA / VA (hex)"
                         FontFamily="{DynamicResource Mono.FontFamily}"
                         Text="{Binding GotoText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding GoToCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="Go" Margin="3,0,0,0"
                        Command="{Binding GoToCommand}" />
                <Border DockPanel.Dock="Left" Style="{StaticResource ToolSeparator}" />
                <TextBlock DockPanel.Dock="Left" Text="Section:" VerticalAlignment="Center" Margin="2,0,4,0"
                           Foreground="{DynamicResource Text.Secondary}" />
                <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                          Width="180" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource Semantic.Error}" />
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="Grid" ItemsSource="{Binding Rows}" Style="{StaticResource DocGrid}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}" RowHeight="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" Width="86">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Semantic.Address}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="00 01 02 03 04 05 06 07  08 09 0A 0B 0C 0D 0E 0F" Binding="{Binding Bytes}" Width="390" />
                <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="*" MinWidth="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Semantic.Ascii}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{DynamicResource Chrome.Background}"
                BorderBrush="{DynamicResource Chrome.Border}" BorderThickness="0,1,0,0" Padding="6,2">
            <TextBlock Text="{Binding PositionInfo}" Style="{StaticResource MonoText}"
                       Foreground="{DynamicResource Text.Secondary}" />
        </Border>
    </Grid>
</UserControl>
