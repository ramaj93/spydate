<UserControl x:Class="Spydate.App.Views.Documents.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:docs="clr-namespace:Spydate.App.ViewModels.Documents"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=docs:NotesDocumentViewModel}"
             Background="{DynamicResource Document.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolStrip}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="New section" Command="{Binding NewSectionCommand}"
                        Margin="2,0,6,0"
                        Visibility="{Binding ShowAsDocument, Converter={StaticResource InverseBoolToVisibility}}" />
                <ToggleButton DockPanel.Dock="Left" Content="View as document" Margin="0,0,8,0"
                              IsChecked="{Binding ShowAsDocument, Mode=TwoWay}"
                              AutomationProperties.Name="View as document"
                              ToolTip="Show every section as one Markdown document" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBlock Text="  ·  a note is what is true of the whole binary, with no address"
                           VerticalAlignment="Center" Foreground="{DynamicResource Text.Tertiary}" />
            </DockPanel>
        </Border>

        <!-- The section list on the left, an editor on the right. Unlike annotations, a note has no
             address to open to, so the pane edits the section rather than reading it. Hidden when the
             document view is on, where the sections are read together instead of edited one at a time. -->
        <Grid Grid.Row="1" Visibility="{Binding ShowAsDocument, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="Grid" ItemsSource="{Binding Rows}" Style="{StaticResource DocGrid}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutomationProperties.Name="Notes">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Section" Binding="{Binding Key}" Width="*"
                                        FontFamily="{DynamicResource Mono.FontFamily}" />
                    <DataGridTextColumn Header="By" Binding="{Binding By}" Width="Auto" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Chrome.Border}" />

            <DockPanel Grid.Column="2" Margin="16,12,16,12">
                <TextBlock DockPanel.Dock="Top" Text="SECTION" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Tertiary}" />
                <TextBox DockPanel.Dock="Top" Text="{Binding EditKey, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,3,0,10" Tag="a short key, e.g. string-xor"
                         FontFamily="{DynamicResource Mono.FontFamily}" />

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="80" Margin="0,0,8,0" />
                    <Button Content="Remove" Command="{Binding RemoveCommand}" MinWidth="80" />
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="TEXT — Markdown, up to 4000 characters" FontSize="10"
                           FontWeight="SemiBold" Foreground="{DynamicResource Text.Tertiary}" Margin="0,0,0,3" />
                <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Tag="what is true of the whole binary — how strings are encoded, what a subsystem does, a dead end"
                         FontFamily="{DynamicResource Mono.FontFamily}" />
            </DockPanel>
        </Grid>

        <!-- The document view: every section rendered as one Markdown document, read-only. The host
             is filled from code-behind with the same renderer the assistant's answers use. -->
        <ScrollViewer Grid.Row="1" x:Name="DocumentHost" Padding="20,14,20,20"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowAsDocument, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="1" Text="No notes to show yet." HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Text.Tertiary}" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowAsDocument}" Value="True" />
                                <Condition Binding="{Binding Rows.Count}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
