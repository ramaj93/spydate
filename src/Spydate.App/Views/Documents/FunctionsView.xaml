<UserControl x:Class="Spydate.App.Views.Documents.FunctionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:docs="clr-namespace:Spydate.App.ViewModels.Documents"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=docs:FunctionsDocumentViewModel}"
             Background="{DynamicResource Document.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ToolStrip}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="2,0,4,0"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBox x:Name="FilterBox" DockPanel.Dock="Left" Width="220" Tag="name or address"
                         TextChanged="OnFilterChanged" />
                <Border DockPanel.Dock="Left" Style="{StaticResource ToolSeparator}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}"
                        Command="{Binding OpenDisassemblyCommand}" CommandParameter="{Binding SelectedItem, ElementName=Grid}" AutomationProperties.Name="Disassemble selected">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Code24" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="Disassemble" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}"
                        Command="{Binding OpenPseudoCCommand}" CommandParameter="{Binding SelectedItem, ElementName=Grid}" AutomationProperties.Name="Decompile selected">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Braces24" FontSize="13" Margin="0,0,4,0" />
                        <TextBlock Text="Decompile" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource Text.Secondary}" />
            </DockPanel>
        </Border>
        <DataGrid Grid.Row="1" x:Name="Grid" ItemsSource="{Binding Rows}" Style="{StaticResource DocGrid}"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Address" Binding="{Binding Va}" Width="140" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
                <DataGridTextColumn Header="Blocks" Binding="{Binding Blocks}" Width="60" />
                <DataGridTextColumn Header="Insns" Binding="{Binding Instructions}" Width="60" />
                <DataGridTextColumn Header="Calls" Binding="{Binding Calls}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
