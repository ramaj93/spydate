<UserControl x:Class="Spydate.App.Views.Documents.SplitCodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:docs="clr-namespace:Spydate.App.ViewModels.Documents"
             xmlns:controls="clr-namespace:Spydate.App.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=docs:SplitCodeDocumentViewModel}"
             Background="{DynamicResource Editor.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolStrip}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Disassembly" VerticalAlignment="Center" Margin="4,0,0,0"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding SyncStatus}" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource Text.Tertiary}" />
                <TextBlock Text="Pseudo-C" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <controls:CodeEditor Grid.Column="0"
                                 BoundText="{Binding DisassemblyText, Mode=OneWay}"
                                 HighlightingName="{Binding DisassemblyHighlighting, Mode=OneWay}"
                                 RevealLine="{Binding DisassemblyLine, Mode=OneWay}"
                                 CaretAddress="{Binding DisassemblyCaretAddress, Mode=OneWayToSource}"
                                 CaretWord="{Binding CaretWord, Mode=OneWayToSource}"
                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <controls:CodeEditor.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="_Rename…" InputGestureText="F2" Command="{Binding RenameSymbolCommand}" />
                        <MenuItem Header="_Comment…" InputGestureText="Ctrl+;" Command="{Binding EditCommentCommand}" />
                        <Separator />
                        <MenuItem Header="Cop_y" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" />
                    </ContextMenu>
                </controls:CodeEditor.ContextMenu>
            </controls:CodeEditor>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <controls:CodeEditor Grid.Column="2"
                                 BoundText="{Binding PseudoCText, Mode=OneWay}"
                                 HighlightingName="{Binding PseudoCHighlighting, Mode=OneWay}"
                                 RevealLine="{Binding PseudoCLine, Mode=OneWay}"
                                 CaretAddress="{Binding PseudoCCaretAddress, Mode=OneWayToSource}"
                                 CaretWord="{Binding CaretWord, Mode=OneWayToSource}"
                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <controls:CodeEditor.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="_Rename…" InputGestureText="F2" Command="{Binding RenameSymbolCommand}" />
                        <MenuItem Header="_Comment…" InputGestureText="Ctrl+;" Command="{Binding EditCommentCommand}" />
                        <Separator />
                        <MenuItem Header="Cop_y" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" />
                    </ContextMenu>
                </controls:CodeEditor.ContextMenu>
            </controls:CodeEditor>
        </Grid>

        <Expander Grid.Row="2" IsExpanded="False" MaxHeight="150"
                  Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
                <TextBlock Foreground="{DynamicResource Semantic.Warning}">
                    <Run Text="Analysis notes (" /><Run Text="{Binding Notes.Count, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
            </Expander.Header>
            <ListBox ItemsSource="{Binding Notes}" MaxHeight="128">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource Text.Secondary}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>
    </Grid>
</UserControl>
