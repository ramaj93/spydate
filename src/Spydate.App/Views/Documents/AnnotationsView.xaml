<UserControl x:Class="Spydate.App.Views.Documents.AnnotationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:docs="clr-namespace:Spydate.App.ViewModels.Documents"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=docs:AnnotationsDocumentViewModel}"
             Background="{DynamicResource Document.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolStrip}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="2,0,4,0"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBox x:Name="FilterBox" DockPanel.Dock="Left" Width="260" Tag="name, comment or address"
                         TextChanged="OnFilterChanged" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource Text.Secondary}" />
                <TextBlock Text="  ·  double-click a row to open it in the listing" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Tertiary}" />
            </DockPanel>
        </Border>

        <!-- The list on the left, what it says on the right. A comment is prose and an address is
             not, so the two want different shapes: a scannable column of addresses, and a pane with
             room to read one. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="Grid" ItemsSource="{Binding Rows}" Style="{StaticResource DocGrid}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      MouseDoubleClick="OnRowDoubleClick"
                      AutomationProperties.Name="Annotations">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="130"
                                        FontFamily="{DynamicResource Mono.FontFamily}" />
                    <DataGridTextColumn Header="Content" Binding="{Binding Content}" Width="*" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open in the listing"
                                  Command="{Binding PlacementTarget.DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Chrome.Border}" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="16,12,16,16"
                          DataContext="{Binding SelectedRow}">
                <StackPanel Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Address}" FontSize="18"
                               FontFamily="{DynamicResource Mono.FontFamily}"
                               Foreground="{DynamicResource Text.Primary}" />
                    <TextBlock Text="{Binding Where}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Value.Type}"
                               Visibility="{Binding Where, Converter={StaticResource NullToCollapsed}}" />

                    <Border Height="1" Margin="0,12" Background="{DynamicResource Chrome.Border}" />

                    <StackPanel Visibility="{Binding HasName, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="NAME" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Tertiary}" />
                        <TextBlock Text="{Binding Name}" Margin="0,3,0,12" TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Mono.FontFamily}"
                                   Foreground="{DynamicResource Value.Keyword}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="COMMENT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Tertiary}" />
                        <TextBlock Text="{Binding Comment}" Margin="0,3,0,12" TextWrapping="Wrap"
                                   LineHeight="19"
                                   Foreground="{DynamicResource Text.Primary}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasLocals, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="LOCAL NAMES" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Tertiary}" />
                        <ItemsControl ItemsSource="{Binding Locals}" Margin="0,3,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Name}" Width="120"
                                                   FontFamily="{DynamicResource Mono.FontFamily}"
                                                   Foreground="{DynamicResource Text.Tertiary}" />
                                        <TextBlock Text="&#x2192;" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource Text.Tertiary}" />
                                        <TextBlock Text="{Binding Value}"
                                                   FontFamily="{DynamicResource Mono.FontFamily}"
                                                   Foreground="{DynamicResource Value.Keyword}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Margin="0,0,0,10" Background="{DynamicResource Chrome.Border}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Set by " Foreground="{DynamicResource Text.Tertiary}" />
                        <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Text.Secondary}" />
                        <TextBlock Text="  ·  " Foreground="{DynamicResource Text.Tertiary}"
                                   Visibility="{Binding Modified, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding Modified}" Foreground="{DynamicResource Text.Secondary}"
                                   Visibility="{Binding Modified, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Sibling of the pane rather than inside it: with nothing selected the pane's own data
                 context is null, and a placeholder bound through it would have nothing to say. -->
            <TextBlock Grid.Column="2" Text="Select an annotation to read it."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Tertiary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="1" Text="Nothing named or commented yet. Rename with F2, comment with Ctrl+;"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Text.Tertiary}"
                   Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisible}}" />
    </Grid>
</UserControl>
