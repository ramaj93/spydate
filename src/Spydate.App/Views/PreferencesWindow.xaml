<Window x:Class="Spydate.App.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Panel.Background}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize}">
    <!-- Settings that belong to the person rather than to a binary. Two sections rather than a tab
         control: there are six lines in total, and a tab strip over six lines is furniture. -->
    <StackPanel Margin="16">

        <TextBlock Text="General" FontWeight="SemiBold" Margin="0,0,0,6" />

        <TextBlock Text="When opening a file with one already open"
                   Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4" />

        <RadioButton x:Name="AskEachTime" GroupName="OpenDestination" Margin="8,2"
                     Content="Ask each time"
                     AutomationProperties.Name="Ask each time" />
        <RadioButton x:Name="AlwaysNewTab" GroupName="OpenDestination" Margin="8,2"
                     Content="Always open a new tab"
                     AutomationProperties.Name="Always open a new tab" />
        <RadioButton x:Name="AlwaysReplace" GroupName="OpenDestination" Margin="8,2"
                     Content="Always replace the current tab"
                     AutomationProperties.Name="Always replace the current tab" />

        <Border Height="1" Background="{DynamicResource Chrome.Border}" Margin="0,14,0,14" />

        <TextBlock Text="Debugging" FontWeight="SemiBold" Margin="0,0,0,6" />

        <TextBlock Text="When execution enters another module"
                   Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4" />

        <RadioButton x:Name="ModuleInCurrentTab" GroupName="ForeignModule" Margin="8,2"
                     Content="Open it in the current tab"
                     AutomationProperties.Name="Open it in the current tab" />
        <RadioButton x:Name="ModuleInOwnTab" GroupName="ForeignModule" Margin="8,2"
                     Content="Open it as its own file tab"
                     AutomationProperties.Name="Open it as its own file tab" />

        <TextBlock Margin="8,4,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource Text.Tertiary}"
                   Text="A tab of its own is read-only: its breakpoints and patches belong to the file that is running, not to the library it stepped into." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" MinWidth="86" Margin="0,0,6,0" IsCancel="True" Click="OnCancel"
                    AutomationProperties.Name="Cancel" />
            <Button Content="Save" MinWidth="86" IsDefault="True" Click="OnSave"
                    AutomationProperties.Name="Save" />
        </StackPanel>
    </StackPanel>
</Window>
