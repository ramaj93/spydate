<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Analysis engines">
    <!-- x86/x64 decoder + formatter (MIT). -->
    <PackageVersion Include="Iced" Version="1.21.0" />
    <!-- ILSpy decompiler engine for managed (.NET) PE files (MIT). -->
    <PackageVersion Include="ICSharpCode.Decompiler" Version="9.1.0.7988" />
  </ItemGroup>

  <ItemGroup Label="Runtime extensions">
    <!--
      PKCS#7 decoding for Authenticode summaries. Microsoft-owned and shipped with the runtime -
      the only reason it needs a reference is that its contract lives outside the default set.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <!-- Fluent / WinUI-style controls for WPF (MIT). -->
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <!-- Code editor used for disassembly / decompiled source views (MIT). -->
    <PackageVersion Include="AvalonEdit" Version="6.3.1.120" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Agent interface">
    <!-- The official C# MCP SDK: the framing and handshake, so only the tools are ours to write. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <!-- Host.CreateApplicationBuilder, which the SDK's DI and stdio transport are built around. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Assistant">
    <!--
      One IChatClient abstraction over every provider, plus FunctionInvokingChatClient, which is the
      tool-calling loop. Writing that loop by hand is where an assistant goes subtly wrong.
    -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <!-- OpenAI-compatible endpoints: OpenAI itself, OpenRouter and DeepSeek differ only by base URL. -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <!-- Anthropic's own SDK, which ships an IChatClient of its own, so no hand-rolled HTTP. -->
    <PackageVersion Include="Anthropic" Version="12.44.0" />
    <!-- DPAPI, so an API key is encrypted to the Windows account rather than sitting in a file. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
