<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A managed debuggee for the ManagedOverlay tests. It is not a test project and not referenced for
    its types - the test project depends on it only so it is built and its exe is on disk. It spins in
    a known managed method so a native pause always finds managed frames to walk, and holds a static
    with a known value so a static read out of memory has something to check.

    x64 to match the debugger and the test host: ClrMD reads a 64-bit process from a 64-bit process.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ManagedDebuggee</AssemblyName>
    <RootNamespace>ManagedDebuggee</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Deterministic frames: nothing here should be inlined or tiered away before the pause. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

</Project>
