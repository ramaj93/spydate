<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Spydate.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Spydate.Core\Spydate.Core.csproj" />
    <ProjectReference Include="..\..\src\Spydate.Disassembly\Spydate.Disassembly.csproj" />
    <ProjectReference Include="..\..\src\Spydate.Decompiler\Spydate.Decompiler.csproj" />
    <ProjectReference Include="..\..\src\Spydate.Mcp\Spydate.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Spydate.Agent\Spydate.Agent.csproj" />
    <ProjectReference Include="..\..\src\Spydate.Debugger\Spydate.Debugger.csproj" />
    <!--
      The managed debuggee for the ManagedOverlay tests. Referenced only so it is built and its exe is
      on disk beside its own bin; the test finds it by path and launches it under the debugger.
      ReferenceOutputAssembly=false so none of its types leak into the test assembly.
    -->
    <ProjectReference Include="..\Spydate.Tests.ManagedDebuggee\ManagedDebuggee.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
